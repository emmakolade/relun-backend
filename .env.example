# Database
DATABASE_URL=mongodb://localhost:27017/relun_db
# Or for MongoDB Atlas:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/relun_db?retryWrites=true&w=majority

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@relun.chat

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ZeptoMail (transactional email). When ZEPTOMAIL_TOKEN is set it is used
# instead of SMTP. Token: ZeptoMail > Mail Agents > SMTP/API > Send Mail token.
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
EMAIL_FROM=noreply@relun.chat
# ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email

# Gmail SMTP (fallback when ZEPTOMAIL_TOKEN is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# Termii (SMS & Email Fallback)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=N-Alert
TERMII_EMAIL_CONFIG_ID=your-termii-email-config-id
TERMII_EMAIL_FROM=noreply@relun.chat

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=path-to-apple-private-key

# Redis (for caching and real-time features)
REDIS_URL=redis://localhost:6379/0

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads

# App Settings
APP_NAME=Relun
APP_VERSION=1.0.0
DEBUG=True

# Native Android app
# Firebase service-account JSON (Firebase console > Project settings > Service accounts), for FCM pushes
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# In prod, set the JSON itself instead (raw or base64) and leave the path unset
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Google Play purchase verification (Play Console > API access > service account with Financial data access)
ANDROID_PACKAGE_NAME=com.relun.app
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./secrets/play-service-account.json

# Coins & Relun Plus
# Coins given to new accounts
SIGNUP_BONUS_COINS=300
# Coins to message someone without a match (a message request)
MESSAGE_REQUEST_COINS=200
# Likes & Views passes bought with coins
INSIGHTS_7D_COINS=700
INSIGHTS_30D_COINS=1500
# Free allowances: likes reset daily, free message requests weekly, Plus requests monthly (Lagos time)
FREE_DAILY_LIKES=15
FREE_WEEKLY_REQUESTS=1
PLUS_MONTHLY_REQUESTS=6
# Date posts live at once for free (more cost DATE_POST_COINS each)
FREE_ACTIVE_DATES=1
PLUS_ACTIVE_DATES=3
DATE_POST_COINS=100
# Relun Plus prices in kobo: 120000 = N1,200 a week, 250000 = N2,500 a month
PLUS_WEEKLY_PRICE=120000
PLUS_MONTHLY_PRICE=250000
# Paystack plan codes for auto-renewing Plus (Paystack dashboard > Payments > Plans).
# Without them the web offers one-time passes only.
PAYSTACK_PLAN_WEEKLY=PLN_p35r2uu09ar75h4
PAYSTACK_PLAN_MONTHLY=PLN_fh0x3rf0kq0m87x
# Google Play subscription for Plus, with base plans "weekly" and "monthly"
# PLAY_PLUS_PRODUCT_ID=relun_plus

# Web coin purchases (Paystack). Webhook URL: https://<api>/api/coins/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CURRENCY=NGN
# Optional per-package prices in minor units (kobo), e.g. 750000 = NGN 7,500
# PAYSTACK_PRICE_COINS_500=100000
# PAYSTACK_PRICE_COINS_1000=200000
# PAYSTACK_PRICE_COINS_2500=450000
# PAYSTACK_PRICE_COINS_6000=900000

# ---------- Security ----------
# At least 32 random characters (the server refuses to start otherwise).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# Web app origins allowed to call the API, comma-separated. Required when NODE_ENV=production.
CORS_ORIGIN=https://relun.chat,https://www.relun.chat
# Proxies in front of the API (load balancer/nginx) so rate limits see the real client IP.
# Use 0 if clients connect to Node directly.
TRUST_PROXY=1

# ---------- Monitoring ----------
# Sentry project DSN (sentry.io > Project settings > Client keys). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# User ids allowed to open /app/admin and GET /api/admin/stats, comma-separated.
ADMIN_USER_IDS=
